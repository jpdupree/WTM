# Race Result JSON feed URLs. Set whichever you have; the API route falls back
# to bundled sample data for any feed that isn't configured.
RACE_FEED_OVERALL=https://api.raceresult.com/348237/A5N5KM8EQMU8KDTHK2HLZGTQ2YLGT5NM
RACE_FEED_MEN=
RACE_FEED_WOMEN=
RACE_FEED_TEAMS=

# Comma-separated bib numbers for "my team" (used by /team and /overlay/team).
NEXT_PUBLIC_TEAM_BIBS=

# How long the server caches each upstream response (seconds).
RACE_CACHE_SECONDS=15
